# Alethic Insight 招新平台 systemd 单元
# 安装（服务器上）：
#   sudo cp /path/to/alethic-recruitment.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now alethic-recruitment
# 环境变量文件：/etc/alethic-recruitment.env（0600 root:root），至少包含：
#   ADMIN_TOKEN=<强随机token>
#   PUBLIC_PREFIX=/recruitment
#   ADMIN_PUBLIC_PATH=/admin/recruitment
#   ALE_THIC_DATA_DIR=/var/www/recruitment/data

[Unit]
Description=Alethic Insight Recruitment (FastAPI via uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/recruitment/current
EnvironmentFile=/etc/alethic-recruitment.env
ExecStart=/var/www/recruitment/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8901
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
